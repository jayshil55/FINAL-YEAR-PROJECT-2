# Copy this file to .env locally and replace placeholders with your own values.
AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key
AWS_SESSION_TOKEN=
BEDROCK_REGION=replace-with-your-aws-region
GEMINI_API_KEY=replace-with-your-gemini-api-key
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
NUTRICARE_AI_MODE=local
DEV_AUTH_ENABLED=false
PGHOST=localhost
PGDATABASE=replace-with-your-database-name
PGUSER=replace-with-your-database-user
PGPASSWORD=replace-with-your-database-password
PGSSLMODE=require
PGCHANNELBINDING=require
PGPORT=5432
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
